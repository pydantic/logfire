class CheckSuppressInstrumentationProcessorWrapper(WrapperSpanProcessor):
    """Checks if instrumentation is suppressed, then suppresses instrumentation itself.

    Placed at the root of the tree of processors.
    """
    def on_start(self, span: Span, parent_context: context.Context | None = None) -> None: ...
    def on_end(self, span: ReadableSpan) -> None: ...

class MainSpanProcessorWrapper(WrapperSpanProcessor):
    """Wrapper around other processors to intercept starting and ending spans with our own global logic.

    Suppresses starting/ending if the current context has a `suppress_instrumentation` value.
    Tweaks the send/receive span names generated by the ASGI middleware.
    """
    def on_end(self, span: ReadableSpan) -> None: ...

def scrub_span(span: ReadableSpan, scrubber: BaseScrubber) -> ReadableSpan: ...

@dataclass
class ScrubbingSpanProcessor(WrapperSpanProcessor):
    scrubber: BaseScrubber
    def on_end(self, span: ReadableSpan) -> None: ...

@dataclass
class _SpanProcessorExporter(SpanExporter):
    """Forward drained records to a processor's `on_end` hook.

    The group that owns the destination processor flushes and shuts it down.
    """
    processor: SpanProcessor
    def export(self, spans: Sequence[ReadableSpan]) -> SpanExportResult: ...

def make_scrubbing_queue(processor: SpanProcessor, scrubber: BaseScrubber) -> BatchSpanProcessor:
    """Queue records for scrubbing before delivering them to a processor."""

class SpanProcessorGroup(SynchronousMultiSpanProcessor):
    """Flush processors that may inherit a no-op force_flush returning None."""
    def force_flush(self, timeout_millis: int = 30000) -> bool: ...

@dataclass
class BackgroundScrubbingSpanProcessor(WrapperSpanProcessor):
    """Send completed spans to the synchronous processors and the scrubbing queue."""
    synchronous_end_processor: SpanProcessor
    background_end_processor: BatchSpanProcessor
    def on_end(self, span: ReadableSpan) -> None: ...

